<?xml version="1.0" encoding="UTF-8"?>

<project name="ChuongTrinhNhanSu" default="default" basedir=".">

    <description>
        Builds, tests, and runs the project ChuongTrinhNhanSu.
    </description>

    <import file="nbproject/build-impl.xml"/>

    <target name="junit6" depends="compile-test">

        <java
            classname="org.junit.platform.console.ConsoleLauncher"
            fork="true"
            failonerror="true">

            <classpath>
                <pathelement location="${basedir}/lib/junit-platform-console-standalone-6.1.3.jar"/>
                <pathelement location="${build.classes.dir}"/>
                <pathelement location="${build.test.classes.dir}"/>
            </classpath>

            <arg value="execute"/>
            <arg value="--class-path"/>
            <arg value="${build.classes.dir};${build.test.classes.dir}"/>
            <arg value="--select-class"/>
            <arg value="unit.JUnit6Test"/>

        </java>

    </target>

</project>